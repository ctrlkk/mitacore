{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "mitacore",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@11.16.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "supervisor:build": "cargo build --release --manifest-path native/napcat-supervisor/Cargo.toml",
    "linux-injector:build": "tsx scripts/build-linux-injector.ts",
    "native:build": "pnpm run supervisor:build && pnpm run linux-injector:build",
    "dev": "pnpm run config:schema && pnpm run package:default-data && pnpm run native:build && node --use-env-proxy --env-file-if-exists=.env packages/bot/scripts/run-vite.mjs --watch",
    "start": "pnpm run config:schema && pnpm run package:default-data && pnpm run native:build && node --use-env-proxy --env-file-if-exists=.env packages/bot/scripts/run-vite.mjs",
    "config:schema": "pnpm --filter bot run config:schema",
    "webui:dev": "pnpm --filter webui dev",
    "webui:build": "pnpm --filter webui build",
    "webui:test": "pnpm --filter webui test:run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db": "pnpm --filter bot exec drizzle-kit",
    "migration": "pnpm --filter bot migration",
    "migration:check": "pnpm --filter bot migration:check",
    "package:default-data": "tsx scripts/default-data.ts",
    "obfuscate": "node scripts/obfuscate.mjs",
    "build": "tsx scripts/build.ts",
    "test": "pnpm --filter bot test && pnpm --filter channels test && pnpm --filter napcat test"
  },
  "devDependencies": {
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@ffprobe-installer/ffprobe": "^2.1.2",
    "@types/gifsicle": "^5.2.2",
    "@types/node": "^24.0.0",
    "fflate": "^0.8.3",
    "gifsicle": "^7.0.1",
    "javascript-obfuscator": "^5.6.0",
    "prettier": "3.8.4",
    "tsx": "^4.20.3"
  },
  "peerDependencies": {
    "typescript": "~6.0.3"
  },
  "prettier": {
    "printWidth": 120
  }
}
