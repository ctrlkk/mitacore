{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "agents-bot",
  "type": "module",
  "private": true,
  "engines": {
    "bun": ">=1.3.14"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "supervisor:build": "cargo build --release --manifest-path packages/napcat-supervisor/Cargo.toml",
    "dev": "bun run supervisor:build && bun run packages/bot/src/index.ts --watch",
    "start": "bun run supervisor:build && bun run packages/bot/src/index.ts",
    "webui:dev": "bun run --cwd packages/webui dev",
    "webui:build": "bun run --cwd packages/webui build",
    "desktop:dev": "bun run --cwd packages/desktop dev",
    "desktop:build": "bun run --cwd packages/desktop build",
    "desktop:package": "bun run --cwd packages/desktop package",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db": "bun --cwd packages/bot drizzle-kit",
    "migration": "bun run packages/bot/scripts/migration.ts",
    "migration:check": "bun run packages/bot/scripts/migration.ts --check",
    "build": "bun run scripts/build.ts"
  },
  "devDependencies": {
    "@tsconfig/bun": "1.0.9",
    "@types/bun": "latest",
    "drizzle-kit": "^0.31.10",
    "esbuild": "^0.28.1",
    "prettier": "3.8.4"
  },
  "peerDependencies": {
    "typescript": "^5.9.3"
  },
  "trustedDependencies": [
    "electron"
  ],
  "prettier": {
    "printWidth": 120
  }
}