{
  "name": "agents-bot",
  "module": "src/index.ts",
  "type": "module",
  "private": true,
  "engines": {
    "bun": ">=1.3.14"
  },
  "workspaces": [
    "node-sidecar"
  ],
  "scripts": {
    "dev": "bun run . --watch",
    "start": "bun run .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db": "drizzle-kit",
    "migration": "bun run scripts/migration.ts",
    "migration:check": "bun run scripts/migration.ts --check",
    "build": "bun run scripts/build.ts"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "drizzle-kit": "^0.31.10",
    "esbuild": "^0.28.1",
    "prettier": "3.8.4"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.81",
    "@ai-sdk/deepseek": "^2.0.35",
    "@ai-sdk/openai": "^3.0.68",
    "@ai-sdk/openai-compatible": "^2.0.48",
    "@larksuiteoapi/node-sdk": "^1.62.1",
    "@types/mime-types": "^3.0.1",
    "ai": "^6.0.170",
    "async-mutex": "^0.5.0",
    "bs58": "^6.0.0",
    "cache-manager": "^7.2.8",
    "dayjs": "^1.11.21",
    "drizzle-orm": "^0.45.2",
    "fast-xml-builder": "^1.2.0",
    "fast-xml-parser": "^5.8.0",
    "glob": "^13.0.6",
    "gray-matter": "^4.0.3",
    "keyv": "^5.6.0",
    "marked": "^18.0.4",
    "mime-types": "^3.0.2",
    "zod": "^4.4.3"
  },
  "prettier": {
    "printWidth": 120
  }
}
