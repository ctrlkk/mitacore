{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "agents-bot",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@11.16.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "supervisor:build": "cargo build --release --manifest-path packages/napcat-supervisor/Cargo.toml",
    "dev": "pnpm --filter bot dev",
    "start": "pnpm --filter bot start",
    "webui:dev": "pnpm --filter webui dev",
    "webui:build": "pnpm --filter webui build",
    "desktop:dev": "pnpm --filter desktop dev",
    "desktop:build": "pnpm --filter desktop build",
    "desktop:package": "pnpm --filter desktop package",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db": "pnpm --filter bot exec drizzle-kit",
    "migration": "pnpm --filter bot migration",
    "migration:check": "pnpm --filter bot migration:check",
    "build": "tsx scripts/build.ts",
    "test": "pnpm --filter bot test && pnpm --filter channels test"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "drizzle-kit": "^0.31.10",
    "esbuild": "^0.28.1",
    "prettier": "3.8.4",
    "tsx": "^4.20.3"
  },
  "peerDependencies": {
    "typescript": "^5.9.3"
  },
  "prettier": {
    "printWidth": 120
  }
}
