{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "bot",
  "type": "module",
  "private": true,
  "module": "src/index.ts",
  "scripts": {
    "supervisor:build": "cargo build --release --manifest-path ../napcat-supervisor/Cargo.toml",
    "dev": "bun run supervisor:build && bun run . --watch",
    "start": "bun run supervisor:build && bun run .",
    "db": "drizzle-kit",
    "migration": "bun run scripts/migration.ts",
    "migration:check": "bun run scripts/migration.ts --check"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.18",
    "@ai-sdk/deepseek": "^3.0.13",
    "@ai-sdk/openai": "^4.0.20",
    "@ai-sdk/openai-compatible": "^3.0.14",
    "@ai-sdk/provider-utils": "^5.0.12",
    "@larksuiteoapi/node-sdk": "^1.71.1",
    "@types/mime-types": "^3.0.1",
    "ai": "^7.0.36",
    "async-mutex": "^0.5.0",
    "bs58": "^6.0.0",
    "cache-manager": "^7.2.9",
    "dayjs": "^1.11.21",
    "drizzle-orm": "^0.45.2",
    "fast-xml-builder": "^1.3.0",
    "fast-xml-parser": "^5.10.1",
    "fflate": "^0.8.3",
    "glob": "^13.0.6",
    "gray-matter": "^4.0.3",
    "hono": "^4.12.31",
    "keyv": "^5.6.0",
    "marked": "^18.0.7",
    "mime-types": "^3.0.2",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "qrcode-terminal": "^0.12.0",
    "smol-toml": "^1.7.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/qrcode-terminal": "^0.12.2"
  }
}
