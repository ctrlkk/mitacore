# 日志
# 日志级别：debug | info | error
LOG_LEVEL=info
# 设为 0 关闭美化输出
LOG_PRETTY=1

# 网络
NODE_USE_ENV_PROXY=1

# Playwright / 图像生成
# 设为 0 禁用启动时预加载 Playwright
PLAYWRIGHT_EAGER_START=0

# Playwright VNC（仅在 packages/playwright 中生效）
# 启用 VNC 模式
# NOVNC=1
# 截图 JPEG 质量
# VIEW_QUALITY=55
# 设为 0 允许页面动画
# VIEW_NO_ANIM=1